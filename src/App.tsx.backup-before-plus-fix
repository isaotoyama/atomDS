h2><ul className="guidelines">{entry.notes.map(note=><li key={note}><Check size={15}/>{note}</li>)}</ul></section><section className="detail-section"><h2>API reference</h2><p>Selected properties. Native HTML props are forwarded where applicable.</p>{entry.props.length?<div className="props-table"><div className="props-header"><span>PROPERTY</span><span>TYPE</span><span>DEFAULT</span></div>{entry.props.map(([name,type,initial])=><div key={name} className="props-row"><code>{name}</code><span>{type}</span><span>{initial}</span></div>)}</div>:<div className="props-empty">This composition currently exposes no custom props.</div>}<div className="detail-quality"><ShieldCheck size={20}/><div><strong>Built for reuse</strong><p>Typed React APIs, semantic design tokens, documented patterns and intentional status labels.</p></div></div></section></div><div className="component-nav"><button disabled={!previous} onClick={()=>previous&&navigate(`/components/${previous.level.toLowerCase()}/${previous.id}`)}><ChevronLeft size={17}/><span><small>PREVIOUS</small>{previous?.name || '—'}</span></button><button disabled={!next} onClick={()=>next&&navigate(`/components/${next.level.toLowerCase()}/${next.id}`)}><span><small>NEXT</small>{next?.name || '—'}</span><ChevronRight size={17}/></button></div></div>;
}

function CommandSearch({open,onClose}: {open:boolean;onClose:()=>void}) { const [query,setQuery] = useState(''); const results=useMemo(()=>registry.filter(e => `${e.name} ${e.description} ${e.level} ${e.category}`.toLowerCase().includes(query.toLowerCase())).slice(0,9),[query]); useEffect(()=>{if(open)setQuery('');},[open]);if(!open)return null;return <div className="search-modal-backdrop" onMouseDown={onClose}><div className="search-modal" role="dialog" aria-modal="true" aria-label="Search the design system" onMouseDown={e=>e.stopPropagation()}><div className="search-modal-input"><Search size={20}/><input aria-label="Search components" autoFocus placeholder="Search ATOM components..." value={query} onChange={e=>setQuery(e.target.value)} onKeyDown={e=>{if(e.key==='Enter'&&results[0]){navigate(`/components/${results[0].level.toLowerCase()}/${results[0].id}`);onClose();}}} /><kbd>ESC</kbd></div><div className="search-results"><span className="eyebrow">{query?'SEARCH RESULTS':'QUICK ACCESS'}</span>{results.map(e=><button key={e.id} onClick={()=>{navigate(`/components/${e.level.toLowerCase()}/${e.id}`);onClose();}}><span className="result-icon"><Component size={17}/></span><span><strong>{e.name}</strong><small>{e.level} · {e.description}</small></span><ArrowRight size={16}/></button>)}{results.length===0&&<div className="search-empty">No components match “{query}”.</div>}</div><div className="search-modal-bottom"><span><kbd>↵</kbd> Open first result</span><span><kbd>ESC</kbd> Close</span><span>{registry.length} components</span></div></div></div>;}

function NotFound(){return <div className="not-found"><div className="not-found-icon"><Box size={30}/></div><h1>Page not found.</h1><p>This piece of the system doesn’t exist yet.</p><Button onClick={()=>navigate('/overview')}>Back to overview</Button></div>;}
function CurrentPage({path}: {path:string}){if(path==='/overview')return <Overview/>;if(path==='/installation')return <Installation/>;if(path==='/principles')return <Principles/>;if(path==='/foundations/colors')return <ColorsPage/>;if(path==='/foundations/typography')return <TypographyPage/>;if(path==='/foundations/spacing')return <SpacingPage/>;if(path==='/foundations/accessibility')return <AccessibilityPage/>;const matched=path.match(/^\/components\/([^/]+)(?:\/([^/]+))?$/);if(matched){const level=levels.find(l=>l.name.toLowerCase()===matched[1]);if(level){if(!matched[2])return <LevelPage key={level.name} level={level.name}/>;const entry=registry.find(e=>e.id===matched[2]&&e.level===level.name);if(entry)return <DetailPage key={entry.id} entry={entry}/>;}}return <NotFound/>;}

export default function App(){const [path,setPath]=useState(getRoute);const [theme,setTheme]=useState<'light'|'dark'>(()=>{try{return localStorage.getItem('atom-theme')==='light'?'light':'dark';}catch{return 'dark';}});const [mobileOpen,setMobileOpen]=useState(false);const [searchOpen,setSearchOpen]=useState(false);useEffect(()=>{document.documentElement.dataset.theme=theme;try{localStorage.setItem('atom-theme',theme);}catch{/* private mode */}},[theme]);useEffect(()=>{const onHash=()=>{setPath(getRoute());window.scrollTo({top:0,behavior:'auto'});};window.addEventListener('hashchange',onHash);return()=>window.removeEventListener('hashchange',onHash);},[]);useEffect(()=>{const onSearch=()=>setSearchOpen(true);const onKey=(e:KeyboardEvent)=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();setSearchOpen(true);}if(e.key==='Escape'){setSearchOpen(false);setMobileOpen(false);}};document.addEventListener('atom-search-open',onSearch);window.addEventListener('keydown',onKey);return()=>{document.removeEventListener('atom-search-open',onSearch);window.removeEventListener('keydown',onKey);};},[]);
  const breadcrumb=path.split('/').filter(Boolean);const pretty=(s:string)=>s.replace(/-/g,' ').replace(/\b\w/g,m=>m.toUpperCase());return <div className="app-shell"><Sidebar path={path} open={mobileOpen} onClose={()=>setMobileOpen(false)}/><div className="app-workspace"><header className="topbar"><div className="topbar-left"><button type="button" className="mobile-menu" aria-label="Open navigation" onClick={()=>setMobileOpen(true)}><Menu size={21}/></button><span className="crumb-root">AT / DOCS</span><ChevronRight size={13}/>{breadcrumb.map((crumb,i)=><span key={i} className={classNames('crumb',i===breadcrumb.length-1&&'is-final')}>{i>0&&<ChevronRight size={13}/>} {pretty(crumb)}</span>)}</div><div className="topbar-right"><button className="topbar-search" onClick={()=>setSearchOpen(true)}><Search size={16}/><span>Search anything...</span><kbd>⌘ K</kbd></button><div className="topbar-separator"/><IconButton variant="ghost" icon={theme==='dark'?<Sun size={19}/>:<Moon size={19}/>} aria-label={theme==='dark'?'Switch to light theme':'Switch to dark theme'} onClick={()=>setTheme(t=>t==='dark'?'light':'dark')}/><div className="topbar-avatar">AT</div></div></header><main className="workspace-main" id="main-content"><CurrentPage path={path}/></main></div><CommandSearch open={searchOpen} onClose={()=>setSearchOpen(false)}/></div>;
}
