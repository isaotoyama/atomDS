function AccessibilityPage(){return <div className="page-enter"><Heading eyebrow="FOUNDATIONS / QUALITY" title="Accessibility" description="Design for the full spectrum of people and input methods, not just a visual ideal."/><div className="a11y-intro"><Accessibility size={26}/><div><h2>Accessibility is a core requirement.</h2><p>ATOM favors native elements, keyboard navigation, visible focus and semantic feedback. These are starting points, not a substitute for product-level testing.</p></div></div><div className="a11y-grid">{[{icon:<MousePointer2/>,title:'Keyboard support',text:'Use buttons for actions and links for navigation. Tabs support arrow, Home and End keys.'},{icon:<Palette/>,title:'Contrast & themes',text:'Semantic tokens provide contrasting dark/light themes. Validate real text and control combinations.'},{icon:<Type/>,title:'Readable content',text:'Keep hierarchy clear, avoid ambiguous labels and support text resizing without clipping.'},{icon:<Zap/>,title:'Reduced motion',text:'Animations are automatically suppressed when users prefer reduced motion.'},{icon:<CircleDot/>,title:'Focus visibility',text:'Every interactive control has a visible :focus-visible treatment and semantic roles.'},{icon:<ShieldCheck/>,title:'Honest status',text:'Use words, icons and live regions for feedback — never communicate solely through color.'}].map(item=><div className="a11y-card" key={item.title}><span>{item.icon}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><div className="doc-note"><ShieldCheck size={19}/><p><strong>Production checklist.</strong> Test keyboard-only flows, screen readers, zoom at 200–400%, high contrast, and real devices. This starter has not been independently audited or certified against WCAG.</p></div></div>;}

