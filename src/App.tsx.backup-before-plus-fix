function CodePanel({code, language='tsx'}: {code: string; language?: string}) {
  const [copied,setCopied] = useState(false);
  async function copy() { try { await navigator.clipboard.writeText(code); setCopied(true); window.setTimeout(() => setCopied(false),1600); } catch { setCopied(false); } }
  return <div className="code-panel"><div className="code-header"><span><FileCode2 size={15} /> {language}</span><button type="button" onClick={copy}>{copied ? <Check size={14}/> : <Copy size={14}/>} {copied ? 'Copied' : 'Copy code'}</button></div><pre><code>{code}</code></pre></div>;
}

