function AtomMark({size=32}: {size?: number}) {
  return <svg aria-hidden="true" width={size} height={size} viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="3.3" fill="currentColor"/><ellipse cx="20" cy="20" rx="17" ry="7.7" stroke="currentColor" strokeWidth="2.2" transform="rotate(0 20 20)"/><ellipse cx="20" cy="20" rx="17" ry="7.7" stroke="currentColor" strokeWidth="2.2" transform="rotate(60 20 20)"/><ellipse cx="20" cy="20" rx="17" ry="7.7" stroke="currentColor" strokeWidth="2.2" transform="rotate(120 20 20)"/></svg>;
