function ColorsPage() { return <div className="page-enter"><Heading eyebrow="FOUNDATIONS / VISUAL LANGUAGE" title="Color system" description="A blue-first palette grounded in semantic meaning. Switch themes to see the same tokens adapt."/><div className="foundation-section"><div className="subheading"><h2>Primitive palette</h2><p>Reference scales used to create semantic roles. Click a label to copy its CSS variable.</p></div><h3>Blue / Primary</h3><div className="palette-grid">{blueColors.map((n,i)=><div className="palette-item" key={n}><div className="palette-color" style={{background:blueHex[i]}}/><CopyToken label={String(n)} value={`var(--at-blue-${n})`}/><small>{blueHex[i]}</small></div>)}</div><h3>Gray / Neutral</h3><div className="palette-grid">{blueColors.map((n,i)=><div className="palette-item" key={n}><div className="palette-color" style={{background:primitiveGrays[i]}}/><CopyToken label={String(n)} value={`var(--at-gray-${n})`}/><small>{primitiveGrays[i]}</small></div>)}</div></div><div className="foundation-section"><div className="subheading"><h2>Semantic colors</h2><p>Use context-based variables. The values update automatically between light and dark.</p></div><div className="semantic-grid">{[{token:'--at-bg',label:'Canvas'},{token:'--at-surface',label:'Surface'},{token:'--at-raised',label:'Raised surface'},{token:'--at-hover',label:'Hover surface'},{token:'--at-brand',label:'Brand / action'},{token:'--at-brand-subtle',label:'Brand subtle'},{token:'--at-success',label:'Success'},{token:'--at-warning',label:'Warning'},{token:'--at-danger',label:'Danger'},{token:'--at-border',label:'Border'},{token:'--at-text',label:'Primary text'},{token:'--at-text-muted',label:'Muted text'}].map(item=><div className="semantic-item" key={item.token}><span style={{background:`var(${item.token})`}}/><div><strong>{item.label}</strong><CopyToken label={`var(${item.token})`} value={`var(${item.token})`}/></div></div>)}</div></div><div className="doc-note"><ShieldCheck size={19}/><p>Semantic token names describe <strong>intent</strong>, so components do not depend on a single color value. Test accessible contrast in the context of actual foreground/background combinations.</p></div></div>; }
function TypographyPage() { const typographies=[{name:'Display',size:48,weight:800,line:1.1},{name:'Heading 1',size:36,weight:800,line:1.2},{name:'Heading 2',size:28,weight:700,line:1.25},{name:'Heading 3',size:22,weight:700,line:1.35},{name:'Body large',size:18,weight:400,line:1.6},{name:'Body',size:16,weight:400,line:1.6},{name:'Small',size:14,weight:500,line:1.5},{name:'Caption',size:12,weight:600,line:1.5}];return <div className="page-enter"><Heading eyebrow="FOUNDATIONS / VISUAL LANGUAGE" title="Typography" description="Clear visual hierarchy, comfortable reading and a practical type scale."/><div className="font-showcase"><div><span className="eyebrow">PRIMARY TYPEFACE</span><h2>DM Sans</h2><p>Human, confident, and readable at every interface size.</p></div><div className="font-letter">Aa<span>0123456789</span></div></div><div className="foundation-section"><div className="subheading"><h2>Type scale</h2><p>A consistent hierarchy for product interfaces and documentation.</p></div><div className="type-list">{typographies.map(t=><div className="type-row" key={t.name}><div><strong>{t.name}</strong><span>{t.size}px / {t.weight}</span></div><span style={{fontSize:`${t.size}px`,fontWeight:t.weight,lineHeight:t.line,letterSpacing:t.size>24?'-.045em':'normal'}}>Design with intention.</span></div>)}</div></div><div className="foundation-section"><div className="subheading"><h2>Monospace</h2><p>JetBrains Mono for code, technical labels and token values.</p></div><div className="mono-example">const system = 'ATOM';<span>// Designed for consistency</span></div></div></div>;}
